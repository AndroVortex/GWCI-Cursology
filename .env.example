# Copia este archivo como .env (en la raíz del repositorio) y llena los valores.
# El .env no se sube a GitHub: las credenciales se comparten por un medio privado.

# Base de datos local (Laragon: root sin contraseña)
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=cursology
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=

# Base de datos de producción (solo si public/index.php usa USE_LOCAL_DB = false)
DB_PROD_HOST=
DB_PROD_PORT=
DB_PROD_NAME=
DB_PROD_USER=
DB_PROD_PASSWORD=
DB_PROD_SSL_CA=

# Base de las pruebas automáticas (php scripts/setup_test_db.php la crea desde cero).
# Vacío = nombre cursology_test en el mismo servidor y con el mismo usuario que la local.
# Si llenas DB_TEST_USER, también se usa DB_TEST_PASSWORD.
DB_TEST_HOST=
DB_TEST_PORT=
DB_TEST_NAME=
DB_TEST_USER=
DB_TEST_PASSWORD=

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes permitidos para CORS, separados por coma (vacío = solo el propio sitio)
APP_ALLOWED_ORIGINS=

# Dirección pública de la app, sin "/" final (p. ej. http://localhost:8000). Se imprime en el
# enlace de verificación de los certificados; vacío = la dirección con la que se abrió la página.
APP_URL=

# PayPal Developers: SOLO credenciales de Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
